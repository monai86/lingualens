  "cards": [
    {
      "dot": "emerald",
      "title": "สิ่งที่วางมาดี",
      "items": [
        "มี canonical frontend/backend เพียงชุดเดียวและมี ADR คุมขอบเขต",
        "FastAPI เป็น policy boundary; browser ไม่เขียนข้อมูลคลินิกโดยตรง",
        "CI ครอบคลุม security scan, matrix tests, UI/E2E และ benchmark"
      ]
    },
    {
      "dot": "amber",
      "title": "หนี้เทคนิคใน Repository",
      "items": [
        "SQL repository 1,781 บรรทัดและ clinical schema 1,133 บรรทัด ควรแยกตาม bounded context",
        "packages/ ยัง import src/ หลายจุด ทำให้ research packaging และ deployment coupling สูง",
        "shared/ ไม่มี active app import แล้ว ควรยืนยันผู้ใช้ก่อน archive หรือถอดออก"
      ]
    },
    {
      "dot": "rose",
      "title": "สิ่งที่ต้องปิดก่อน Production",
      "items": [
        "พิสูจน์ Supabase Auth claims, RLS สอง tenant และ private Storage บน staging จริง",
        "ทำให้ queue policy ตรงกัน: เอกสารบอกว่ายังไม่ต้อง Redis แต่ production config บังคับ Redis",
        "แยกและทำให้ working tree 127 modified + 12 untracked groups กลับสู่ candidate ที่รีวิวได้"
      ]
    }
  ]
